# apps/api/.env.local
OPENAI_API_KEY=
DATABASE_URL=local.db
PORT=4000
WEB_ORIGIN=http://localhost:3000

# apps/web/.env.local (optional; defaults shown)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WORKSPACE_ID=ws_demo

# apps/api: background jobs + schedules (disabled when REDIS_URL is unset)
# REDIS_URL=redis://localhost:6379
# Optional Slack notifications for scheduled reports (https://hooks.slack.com only)
# SLACK_WEBHOOK_URL=

# apps/api/.env.local: connectors (read-only). Used by `pnpm --filter api connect <provider> --workspace <id>`.
# Generate with: openssl rand -base64 32
# CONNECTOR_ENCRYPTION_KEY=
# Meta Ads: token needs the ads_read permission (a System User token is best; it does not expire every 60 days)
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=act_1234567890
# META_CONVERSION_ACTION=purchase        # or "lead"; exactly one action type is counted
# GA4: create a service account, download its JSON key, and add its email as a Viewer on the GA4 property
# GA4_PROPERTY_ID=123456789
# GA4_SERVICE_ACCOUNT_FILE=/absolute/path/to/key.json
