# apps/api/.env.local
OPENAI_API_KEY=
DATABASE_URL=local.db
PORT=4000
WEB_ORIGIN=http://localhost:3000

# apps/web/.env.local (optional; defaults shown)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WORKSPACE_ID=ws_demo

# apps/api: background jobs + schedules (disabled when REDIS_URL is unset)
# REDIS_URL=redis://localhost:6379
# Optional Slack notifications for scheduled reports (https://hooks.slack.com only)
# SLACK_WEBHOOK_URL=

# apps/api/.env.local: connectors (read-only OAuth; see README "Connecting your accounts")
# Generate with: openssl rand -base64 32
# CONNECTOR_ENCRYPTION_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# API_PUBLIC_URL=http://localhost:4000
# WEB_ORIGIN=http://localhost:3000
# Daily connector sync (needs REDIS_URL). Default 05:00 UTC; at most hourly.
# SYNC_CRON=0 5 * * *
# SYNC_TIMEZONE=UTC
